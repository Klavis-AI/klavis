# fastCRW API credentials
CRW_API_KEY=your-api-key-here
# Base URL for the fastCRW API. Defaults to the managed cloud.
# Override for self-hosted instances (comment out if using cloud service).
# CRW_API_URL=https://fastcrw.com/api

# Retry configuration
CRW_RETRY_MAX_ATTEMPTS=3
CRW_RETRY_INITIAL_DELAY=1000
CRW_RETRY_MAX_DELAY=10000
CRW_RETRY_BACKOFF_FACTOR=2
